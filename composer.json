{
    "name": "ashham/woocommerce-gateway",
    "description": "BML Connect Payment Gateway for WooCommerce - Secure payments via Bank of Maldives Connect API v2.0 with real-time webhooks support",
    "type": "wordpress-plugin",
    "keywords": [
        "woocommerce", 
        "payment-gateway", 
        "bml", 
        "bank-of-maldives", 
        "maldives", 
        "payments", 
        "e-commerce",
        "wordpress",
        "plugin"
    ],
    "homepage": "https://github.com/ahmed3salah/woocommerce-bml-mpos-integration",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Ahmed Salah",
            "email": "ahmed3salah311@gmail.com",
            "role": "Full-Stack Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/ahmed3salah/woocommerce-bml-mpos-integration/issues",
        "docs": "https://github.com/ahmed3salah/woocommerce-bml-mpos-integration/blob/main/README.md",
        "source": "https://github.com/ahmed3salah/woocommerce-bml-mpos-integration"
    },
    "require": {
        "php": ">=7.4",
        "bankofmaldives/bml-connect-php": "^2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.6",
        "phpcompatibility/php-compatibility": "^9.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7"
    },
    "suggest": {
        "monolog/monolog": "For enhanced logging capabilities",
        "guzzlehttp/guzzle": "Already included via BML Connect SDK for HTTP requests"
    },
    "autoload": {
        "psr-4": {
            "BMLConnect\\WooCommerce\\": "app/"
        },
        "files": [
            "app/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "BMLConnect\\WooCommerce\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "cs": "phpcs --standard=WordPress app/",
        "cs-fix": "phpcbf --standard=WordPress app/",
        "php-compat": "phpcs --standard=PHPCompatibility --runtime-set testVersion 7.4- app/",
        "security-check": "composer audit",
        "analyze": [
            "@cs",
            "@php-compat",
            "@security-check"
        ],
        "post-install-cmd": [
            "@php -r \"if (!file_exists('.env.example') && file_exists('.env.example.dist')) copy('.env.example.dist', '.env.example');\""
        ],
        "post-update-cmd": [
            "@php -r \"echo 'Dependencies updated successfully. Please test the plugin thoroughly.\\n';\""
        ]
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit tests",
        "test-coverage": "Run tests with coverage report",
        "cs": "Check coding standards",
        "cs-fix": "Fix coding standards violations",
        "php-compat": "Check PHP compatibility",
        "security-check": "Check for security vulnerabilities",
        "analyze": "Run all code analysis tools"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "classmap-authoritative": false,
        "apcu-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "wordpress-install-dir": "wp-content/plugins/bml-connect-woocommerce",
        "plugin-slug": "bml-connect-woocommerce",
        "text-domain": "woocommerce_bml_mpos_integration",
        "version": "2.0.0",
        "requires-wp": "5.0",
        "tested-wp": "6.4",
        "requires-woocommerce": "3.0",
        "tested-woocommerce": "8.3",
        "requires-php": "7.4"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/tests",
            "/coverage",
            "/.git",
            "/.github",
            "/node_modules",
            "/vendor-dev",
            "phpunit.xml",
            "phpcs.xml",
            ".phpcs.xml.dist",
            ".gitignore",
            ".gitattributes",
            ".env*",
            "composer.lock",
            "*.log"
        ]
    }
}
